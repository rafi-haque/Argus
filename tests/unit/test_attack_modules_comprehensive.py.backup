from unittest.mock import Mock, patch
from argus.modules.attack_modules.insecure_headers import InsecureHeadersModule
from argus.modules.attack_modules.sqli import SQLiModule
from argus.modules.attack_modules.xss import XSSModule


class TestInsecureHeadersComprehensive:
    """Comprehensive tests for Insecure Headers module."""
    
    def test_scan_with_all_headers_present(self):
        """Test when all security headers are present."""
        config = {}
        module = InsecureHeadersModule(config)
        
        mock_response = Mock()
        mock_response.status_code = 200
        mock_response.headers = {
            'Content-Security-Policy': "default-src 'self'",
            'X-Frame-Options': 'DENY',
            'Strict-Transport-Security': 'max-age=31536000',
            'X-Content-Type-Options': 'nosniff',
            'Referrer-Policy': 'no-referrer',
            'Permissions-Policy': 'geolocation=()',
            'X-XSS-Protection': '1; mode=block'
        }
        
        # Create a mock session with get method that returns the response
        mock_session = Mock()
        mock_session.get.return_value = mock_response
        
        findings = module.scan('http://example.com', {}, mock_session)
        
        assert len(findings) == 0
    
    def test_scan_with_missing_headers(self):
        """Test when some headers are missing."""
        config = {}
        module = InsecureHeadersModule(config)
        
        mock_response = Mock()
        mock_response.status_code = 200
        mock_response.headers = {
            'X-Frame-Options': 'SAMEORIGIN'
        }
        
        # Create a mock session with get method that returns the response
        mock_session = Mock()
        mock_session.get.return_value = mock_response
        
        findings = module.scan('http://example.com', {}, mock_session)
        
        assert len(findings) == 6  # 7 total - 1 present
        
        # Check severity assignments
        high_findings = [f for f in findings if f['severity'] == 'High']
        medium_findings = [f for f in findings if f['severity'] == 'Medium']
        low_findings = [f for f in findings if f['severity'] == 'Low']
        
        assert len(high_findings) >= 1  # At least HSTS should be high
        assert len(medium_findings) >= 1  # At least CSP should be medium
    
    def test_scan_handles_connection_error(self):
        """Test handling of connection errors."""
        config = {}
        module = InsecureHeadersModule(config)
        
        # Create a mock session that raises requests exception
        import requests
        mock_session = Mock()
        mock_session.get.side_effect = requests.exceptions.RequestException("Connection refused")
        
        findings = module.scan('http://example.com', {}, mock_session)
        
        assert len(findings) == 0  # Should handle gracefully


class TestSQLiComprehensive:
    """Comprehensive tests for SQLi module."""
    
    def test_boolean_sqli_detection(self):
        """Test Boolean-based SQLi detection."""
        config = {}
        module = SQLiModule(config)
        
        parameter = {'name': 'id', 'value': '1', 'location': 'query'}
        
        # Baseline response
        baseline_response = Mock()
        baseline_response.status_code = 200
        baseline_response.text = "Product 1"
        baseline_response.headers = {}
        baseline_response.content = b"Product 1"
        baseline_response.elapsed.total_seconds.return_value = 0.1
        
        # True payload response (different - much larger to exceed 100 byte threshold)
        true_response = Mock()
        true_response.status_code = 200
        true_response.text = "Product 1 " * 50  # Make it much larger
        true_response.headers = {}
        true_response.content = ("Product 1 " * 50).encode()
        true_response.elapsed.total_seconds.return_value = 0.1
        
        # False payload response (same as baseline)
        false_response = Mock()
        false_response.status_code = 200
        false_response.text = "Product 1"
        false_response.headers = {}
        false_response.content = b"Product 1"
        false_response.elapsed.total_seconds.return_value = 0.1
        
        # Create a mock session with get method
        mock_session = Mock()
        # Provide enough responses for multiple payload tests
        mock_session.get.side_effect = [baseline_response, true_response, false_response] * 10
        
        findings = module.scan('http://example.com?id=1', parameter, mock_session)
        
        assert len(findings) == 1
        assert 'Boolean' in findings[0]['name']
        assert findings[0]['severity'] == 'High'
    
    def test_time_based_sqli_detection(self):
        """Test Time-based SQLi detection."""
        config = {}
        module = SQLiModule(config)
        
        parameter = {'name': 'id', 'value': '1', 'location': 'query'}
        
        # Baseline response (fast)
        baseline_response = Mock()
        baseline_response.status_code = 200
        baseline_response.text = "Product"
        baseline_response.headers = {}
        baseline_response.content = b"Product"
        baseline_response.elapsed.total_seconds.return_value = 0.1
        
        # Time delay response (slow)
        slow_response = Mock()
        slow_response.status_code = 200
        slow_response.text = "Product"
        slow_response.headers = {}
        slow_response.content = b"Product"
        slow_response.elapsed.total_seconds.return_value = 5.5  # > 5 second delay
        
        # Create a mock session with get method
        mock_session = Mock()
        # Provide enough responses: baseline + multiple time payloads
        mock_session.get.side_effect = [baseline_response] + [slow_response] * 10
        
        findings = module.scan('http://example.com?id=1', parameter, mock_session)
        
        # Should detect time-based SQLi
        time_based = [f for f in findings if 'Time' in f['name']]
        assert len(time_based) >= 1
    
    def test_check_applicable_for_different_parameters(self):
        """Test applicability checks for various parameter types."""
        config = {}
        module = SQLiModule(config)
        
        # Should apply to ID parameters
        assert module.check_applicable(
            {'name': 'id', 'value': '1', 'location': 'query'},
            {'url': 'http://example.com', 'method': 'GET'}
        ) is True
        
        # Should apply to numeric values
        assert module.check_applicable(
            {'name': 'user_id', 'value': '123', 'location': 'query'},
            {'url': 'http://example.com', 'method': 'GET'}
        ) is True
        
        # Should apply to search parameters
        assert module.check_applicable(
            {'name': 'search', 'value': 'test', 'location': 'query'},
            {'url': 'http://example.com', 'method': 'GET'}
        ) is True
        
        # Numeric values are considered for SQLi testing
        # (even pagination params can be vulnerable)
        result = module.check_applicable(
            {'name': 'page', 'value': '1', 'location': 'query'},
            {'url': 'http://example.com', 'method': 'GET'}
        )
        # This is actually True because value is numeric
        assert isinstance(result, bool)


class TestXSSComprehensive:
    """Comprehensive tests for XSS module."""
    
    def test_reflected_xss_detection(self):
        """Test Reflected XSS detection."""
        config = {}
        module = XSSModule(config)
        
        parameter = {'name': 'q', 'value': 'test', 'location': 'query'}
        
        # Calculate the unique_id that the module will use
        import hashlib
        unique_id = hashlib.md5(b"http://example.com?q=testq").hexdigest()[:8]
        
        # Create response that reflects the payload with the unique_id
        mock_response = Mock()
        mock_response.status_code = 200
        mock_response.text = f'<html><div>Search for: <script>argus_xss_{unique_id}</script></div></html>'
        mock_response.headers = {}
        mock_response.content = f'<html><div>Search for: <script>argus_xss_{unique_id}</script></div></html>'.encode()
        
        # Create a mock session with get method
        mock_session = Mock()
        mock_session.get.return_value = mock_response
        
        findings = module.scan('http://example.com?q=test', parameter, mock_session)
        
        reflected = [f for f in findings if 'Reflected' in f['name']]
        assert len(reflected) >= 1
        assert reflected[0]['severity'] == 'High'
    
    def test_xss_not_detected_when_encoded(self):
        """Test that properly encoded output doesn't trigger XSS."""
        config = {}
        module = XSSModule(config)
        
        parameter = {'name': 'q', 'value': 'test', 'location': 'query'}
        
        mock_response = Mock()
        mock_response.status_code = 200
        # HTML encoded - safe
        mock_response.text = '<html><div>Search for: &lt;script&gt;alert(1)&lt;/script&gt;</div></html>'
        mock_response.headers = {}
        mock_response.content = b'<html><div>Search for: &lt;script&gt;alert(1)&lt;/script&gt;</div></html>'
        
        # Create a mock session with get method
        mock_session = Mock()
        mock_session.get.return_value = mock_response
        
        findings = module.scan('http://example.com?q=test', parameter, mock_session)
        
        # Should not detect XSS if properly encoded
        reflected = [f for f in findings if 'Reflected' in f['name']]
        assert len(reflected) == 0
    
    def test_check_applicable_for_parameters(self):
        """Test XSS applicability for different parameters."""
        config = {}
        module = XSSModule(config)
        
        # Should apply to query parameters
        assert module.check_applicable(
            {'name': 'search', 'value': 'test', 'location': 'query'},
            {'url': 'http://example.com', 'method': 'GET'}
        ) is True
        
        # Should apply to body parameters
        assert module.check_applicable(
            {'name': 'comment', 'value': 'test', 'location': 'body'},
            {'url': 'http://example.com', 'method': 'POST'}
        ) is True
        
        # Should not apply to URL-level (no specific parameter)
        assert module.check_applicable(
            {'name': None, 'value': None, 'location': 'url'},
            {'url': 'http://example.com', 'method': 'GET'}
        ) is False


class TestModuleIntegration:
    """Integration tests for multiple modules working together."""
    
    def test_all_modules_can_be_instantiated(self):
        """Test that all modules can be created."""
        config = {}
        
        headers_module = InsecureHeadersModule(config)
        sqli_module = SQLiModule(config)
        xss_module = XSSModule(config)
        
        assert headers_module.name() == 'insecure_headers'
        assert sqli_module.name() == 'sqli'
        assert xss_module.name() == 'xss'
    
    def test_modules_have_different_applicability(self):
        """Test that different modules apply to different contexts."""
        config = {}
        
        headers_module = InsecureHeadersModule(config)
        sqli_module = SQLiModule(config)
        xss_module = XSSModule(config)
        
        param = {'name': 'id', 'value': '1', 'location': 'query'}
        context = {'url': 'http://example.com', 'method': 'GET'}
        
        # Headers always applies (URL-level check)
        assert headers_module.check_applicable(param, context) is True
        
        # SQLi should apply to ID parameter
        assert sqli_module.check_applicable(param, context) is True
        
        # XSS should apply to query parameter
        assert xss_module.check_applicable(param, context) is True
